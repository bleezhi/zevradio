%YAML 1.2
---
file_format: 1
metadata:
  file_format: 1
  grc_version: 3.10.12.0
  title: UVB-76 Buzzer IQ TCP
  description: Software-only UVB-76-style buzzer with repeated rough-sounding bursts
  author: bleez
options:
  parameters:
    author: bleez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    description: UVB-76-style buzzer simulation to SimTx
    generate_options: qt_gui
    id: uvb76_buzzer_iq_tcp
    output_language: python
    run: 'True'
    thread_safe_setters: ''
    title: UVB-76 Buzzer IQ TCP
  states:
    bus_sink: false
    bus_source: false
    coordinate: [0, 0]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    coordinate: [32, 32]
    rotation: 0
- name: buzz_freq
  id: variable
  parameters:
    comment: ''
    value: '625'
  states:
    coordinate: [32, 96]
    rotation: 0
- name: buzz_rate
  id: variable
  parameters:
    comment: ''
    value: '1.0/2.5'
  states:
    coordinate: [32, 160]
    rotation: 0
- name: buzz_amp
  id: variable
  parameters:
    comment: ''
    value: '0.85'
  states:
    coordinate: [32, 224]
    rotation: 0
- name: noise_amp
  id: variable
  parameters:
    comment: ''
    value: '0.07'
  states:
    coordinate: [32, 288]
    rotation: 0
- name: tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: buzz_amp
    comment: ''
    freq: buzz_freq
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    type: complex
    waveform: 'analog.GR_SIN_WAVE'
  states:
    coordinate: [256, 128]
    rotation: 0
- name: noise
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_amp
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: 'analog.GR_GAUSSIAN'
    seed: '42'
    type: complex
  states:
    coordinate: [256, 256]
    rotation: 0
- name: add
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    coordinate: [480, 160]
    rotation: 0
- name: envelope
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.5'
    comment: ''
    freq: buzz_rate
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0.5'
    phase: '0'
    samp_rate: samp_rate
    type: float
    waveform: 'analog.GR_SQR_WAVE'
  states:
    coordinate: [480, 320]
    rotation: 0
- name: envelope_complex
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    coordinate: [704, 320]
    rotation: 0
- name: multiply
  id: blocks_multiply_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    coordinate: [912, 176]
    rotation: 0
- name: tcp_sink
  id: network_tcp_sink
  parameters:
    addr: 127.0.0.1
    affinity: ''
    alias: ''
    comment: ''
    eof: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu: '1472'
    port: '2000'
    type: complex
  states:
    coordinate: [1152, 176]
    rotation: 0
connections:
- [tone, '0', add, '0']
- [noise, '0', add, '1']
- [add, '0', multiply, '0']
- [envelope, '0', envelope_complex, '0']
- [envelope_complex, '0', multiply, '1']
- [multiply, '0', tcp_sink, '0']
